{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "salnama-blocks/advanced-accordion",
  "title": "آکاردیون پیشرفته",
  "description": "بلوک آکاردیون پیشرفته با قابلیت inner blocks",
  "category": "salnama-blocks",
  "icon": "editor-justify",
  "attributes": {
    "accordionStyle": {
      "type": "string",
      "default": "vertical"
    },
    "multipleOpen": {
      "type": "boolean",
      "default": false
    },
    "animationDuration": {
      "type": "number",
      "default": 300
    },
    "salnamaAnimation": {
      "type": "string",
      "default": ""
    },
    "salnamaAnimationDelay": {
      "type": "string",
      "default": ""
    },
    "salnamaAnimationDuration": {
      "type": "string",
      "default": ""
    },
    "isNested": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "padding": true,
      "margin": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "script": "file:./view.js",
  "render": "file:./render.php"
}